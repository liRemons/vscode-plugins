{
  "name": "markdown-editor-extension",
  "displayName": "Remons Markdown Editor",
  "description": "基于 React 组件 remons-markdown-editor 的 VSCode Markdown 可视化编辑器（Custom Editor）",
  "version": "0.0.3",
  "publisher": "remons",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liRemons/vscode-plugins.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "preview",
    "wysiwyg",
    "katex",
    "highlight"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "remons.markdownEditor",
        "displayName": "Remons Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "remonsMarkdownEditor.openPreview",
        "title": "Remons Markdown: 以可视化编辑器打开",
        "icon": {
          "light": "media/icon-preview-light.svg",
          "dark": "media/icon-preview-dark.svg"
        }
      },
      {
        "command": "remonsMarkdownEditor.openSource",
        "title": "Remons Markdown: 以文本编辑器打开",
        "icon": {
          "light": "media/icon-source-light.svg",
          "dark": "media/icon-source-dark.svg"
        }
      },
      {
        "command": "remonsMarkdownEditor.modePreview",
        "title": "Remons Markdown: 切换到预览",
        "enablement": "remonsMarkdownEditorActive",
        "icon": {
          "light": "media/icon-preview-light.svg",
          "dark": "media/icon-preview-dark.svg"
        }
      },
      {
        "command": "remonsMarkdownEditor.modeEdit",
        "title": "Remons Markdown: 切换到编辑",
        "enablement": "remonsMarkdownEditorActive",
        "icon": {
          "light": "media/icon-edit-light.svg",
          "dark": "media/icon-edit-dark.svg"
        }
      },
      {
        "command": "remonsMarkdownEditor.toggleTheme",
        "title": "Remons Markdown: 切换深色/浅色主题",
        "enablement": "remonsMarkdownEditorActive",
        "icon": {
          "light": "media/icon-theme-light.svg",
          "dark": "media/icon-theme-dark.svg"
        }
      },
      {
        "command": "remonsMarkdownEditor.toggleImmersive",
        "title": "Remons Markdown: 切换沉浸式编辑",
        "enablement": "remonsMarkdownEditorActive",
        "icon": {
          "light": "media/icon-immersive-light.svg",
          "dark": "media/icon-immersive-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "remonsMarkdownEditor.modeEdit",
          "when": "remonsMarkdownEditorActive && remonsMarkdownEditorMode != edit",
          "group": "navigation@1"
        },
        {
          "command": "remonsMarkdownEditor.modePreview",
          "when": "remonsMarkdownEditorActive && remonsMarkdownEditorMode == edit",
          "group": "navigation@1"
        },
        {
          "command": "remonsMarkdownEditor.openSource",
          "when": "remonsMarkdownEditorActive",
          "group": "navigation@2"
        },
        {
          "command": "remonsMarkdownEditor.toggleTheme",
          "when": "remonsMarkdownEditorActive",
          "group": "navigation@3"
        },
        {
          "command": "remonsMarkdownEditor.toggleImmersive",
          "when": "remonsMarkdownEditorActive && remonsMarkdownEditorMode == edit",
          "group": "navigation@3"
        },
        {
          "command": "remonsMarkdownEditor.openPreview",
          "when": "editorLangId == markdown && !remonsMarkdownEditorActive",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "remonsMarkdownEditor.modeEdit",
          "when": "remonsMarkdownEditorActive && remonsMarkdownEditorMode != edit"
        },
        {
          "command": "remonsMarkdownEditor.modePreview",
          "when": "remonsMarkdownEditorActive && remonsMarkdownEditorMode == edit"
        },
        {
          "command": "remonsMarkdownEditor.openSource",
          "when": "remonsMarkdownEditorActive"
        },
        {
          "command": "remonsMarkdownEditor.openPreview",
          "when": "resourceLangId == markdown && !remonsMarkdownEditorActive"
        },
        {
          "command": "remonsMarkdownEditor.toggleTheme",
          "when": "remonsMarkdownEditorActive"
        },
        {
          "command": "remonsMarkdownEditor.toggleImmersive",
          "when": "remonsMarkdownEditorActive"
        }
      ],
      "explorer/context": [
        {
          "command": "remonsMarkdownEditor.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        }
      ]
    },
    "configuration": {
      "title": "Remons Markdown Editor",
      "properties": {
        "remonsMarkdownEditor.defaultMode": {
          "type": "string",
          "enum": [
            "preview",
            "edit"
          ],
          "enumDescriptions": [
            "只读预览：仅渲染 Markdown，不可编辑",
            "可视化编辑：CodeMirror 编辑 + 实时预览"
          ],
          "default": "preview",
          "description": "打开 Markdown 文件时默认进入的视图模式"
        },
        "remonsMarkdownEditor.theme": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ],
          "enumDescriptions": [
            "深色主题（默认）",
            "浅色主题",
            "跟随 VSCode 当前主题"
          ],
          "default": "dark",
          "description": "编辑器与预览的主题模式；运行时切换会覆盖此默认值"
        },
        "remonsMarkdownEditor.showPreview": {
          "type": "boolean",
          "default": true,
          "description": "是否显示实时预览面板"
        },
        "remonsMarkdownEditor.immersive": {
          "type": "boolean",
          "default": false,
          "description": "是否默认进入沉浸式编辑（编辑模式下隐藏实时预览面板）"
        },
        "remonsMarkdownEditor.fullscreen": {
          "type": "boolean",
          "default": false,
          "description": "是否显示全屏按钮"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "dev": "node dev.js",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc --noEmit -p ./",
    "check-types": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remons-markdown-editor": "^2.0.0-beta.5",
    "remons-render-markdown": "^2.0.1-beta.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
